BOT_APP_ID=
BOT_APP_PASSWORD=
BOT_APP_TENANT_ID=
FOUNDRY_ENDPOINT=https://your-foundry-endpoint/openai/v1
FOUNDRY_MODEL_ID=
FOUNDRY_AUTH_MODE=entra
# Required only when FOUNDRY_AUTH_MODE=api-key
FOUNDRY_API_KEY=
# Optional. Default value is 2024-10-21.
FOUNDRY_API_VERSION=2024-10-21
# Optional. Default value is https://cognitiveservices.azure.com/.default
FOUNDRY_ENTRA_SCOPE=https://cognitiveservices.azure.com/.default
# Optional. Use for user-assigned managed identity in Azure.
FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=
SYSTEM_PROMPT=You are a helpful assistant in Microsoft Teams.
